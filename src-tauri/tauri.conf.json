{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "finnca",
  "version": "0.1.0",
  "identifier": "com.finnca.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Finnca",
        "width": 1280,
        "height": 720,
        "maximized": false,
        "fullscreen": false,
        "resizable": true,
        "backgroundColor": "#0e0f0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'ipc:' https://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/endrico-fn/finnca/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwODFCMEQzNUNBMkY0MjYKUldRbTlLSmMwN0NCOEs1ZGROdkoraGliZ3VjRGd4MVRCUFZlMDFwV2lZZmxHcGlwdThRNjVPNUwK",
      "windows": {
        "installerArgs": [],
        "installMode": "passive"
      }
    }
  }
}
